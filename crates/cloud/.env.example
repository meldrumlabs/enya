# Enya Cloud - Environment Configuration
#
# Copy this file to .env and fill in the values.
# Required variables are marked with (REQUIRED).

# =============================================================================
# Database
# =============================================================================

# Full database URL (for local development)
DATABASE_URL=postgres://enya:enya@localhost:5432/enya

# PostgreSQL credentials (for docker-compose)
POSTGRES_USER=enya
POSTGRES_PASSWORD=enya
POSTGRES_DB=enya
POSTGRES_PORT=5432

# =============================================================================
# Authentication (REQUIRED for production)
# =============================================================================

# JWT secret for signing tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production

# JWT token expiry in seconds (default: 7 days)
JWT_EXPIRY_SECS=604800

# =============================================================================
# GitHub OAuth (optional, but recommended for production)
# =============================================================================

# Create at: https://github.com/settings/developers
# Callback URL: https://your-domain.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Server Configuration
# =============================================================================

HOST=0.0.0.0
PORT=3000

# Frontend URL for invite links and OAuth redirects
FRONTEND_URL=http://localhost:8080

# Enable dev auth endpoint (set to false in production!)
DEV_AUTH=true

# =============================================================================
# Logging
# =============================================================================

# Log level (debug, info, warn, error)
RUST_LOG=enya_cloud=debug,tower_http=debug
