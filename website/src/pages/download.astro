---
import ThemeProvider from '../components/ThemeProvider.astro';
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Download - Enya</title>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="description" content="Download Enya for macOS or try in browser" />
		<meta property="og:image" content="/img/enya.png" />
		<meta property="og:image:alt" content="Enya" />
	</head>
	<body>
		<ThemeProvider />
		<div class="page">
			<header class="header">
				<div class="header-content">
					<div class="title-wrapper">
						<a href="/" class="site-title">
							<img src="/img/enya.png" alt="Enya" />
						</a>
					</div>
					<div class="right-group">
						<div class="header-links">
							<a href="/docs" class="header-link">docs</a>
							<a href="https://github.com/meldrumlabs/enya" target="_blank" rel="noopener noreferrer" class="header-link" id="github-link">github</a>
						</div>
						<button class="theme-toggle" onclick="toggleTheme()" aria-label="Switch to light mode">
							<svg class="theme-icon theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
							<svg class="theme-icon theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
						</button>
						<button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
							<span class="menu-icon menu-icon-bars">☰</span>
							<span class="menu-icon menu-icon-times">✕</span>
						</button>
					</div>
					<div class="mobile-menu" id="mobile-menu">
						<a href="/docs" class="mobile-menu-link">docs</a>
						<a href="https://github.com/meldrumlabs/enya" target="_blank" rel="noopener noreferrer" class="mobile-menu-link" id="mobile-github-link">github</a>
						<button class="mobile-menu-link mobile-theme-toggle" onclick="toggleTheme()">toggle theme</button>
					</div>
				</div>
			</header>
			<main class="main">
				<section class="downloads-section">
					<div class="downloads-content">
						<h1 class="downloads-title">Download Enya</h1>
						<div class="downloads-grid-primary">
							<a href="https://github.com/meldrumlabs/enya/releases/latest/download/Enya.dmg" target="_blank" rel="noopener noreferrer" class="download-card download-card-featured">
								<div class="download-icon">
									<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
									</svg>
								</div>
								<h3 class="download-platform">macOS</h3>
								<p class="download-detail">10.15 or later</p>
							</a>
							<a href="/editor" class="download-card">
								<div class="download-icon">
									<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"/>
										<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
										<path d="M2 12h20"/>
									</svg>
								</div>
								<h3 class="download-platform">Try in Browser</h3>
								<p class="download-detail">WASM · No install required</p>
							</a>
						</div>
						<div class="terminal-install">
							<p class="terminal-label">All platforms</p>
							<div class="terminal-block">
								<span class="terminal-prompt">$</span>
								<code class="terminal-command">cargo install enya</code>
								<button class="terminal-copy" onclick="navigator.clipboard.writeText('cargo install enya').then(() => { this.querySelector('.icon-copy').style.display = 'none'; this.querySelector('.icon-check').style.display = 'block'; setTimeout(() => { this.querySelector('.icon-copy').style.display = 'block'; this.querySelector('.icon-check').style.display = 'none'; }, 1500); })" aria-label="Copy install command"><svg class="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--obsidian-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg></button>
							</div>
						</div>
					</div>
				</section>
			</main>
			<footer class="footer">
				<div class="footer-bottom">
					<div class="copyright-wrapper">
						© 2026 <a href="https://meldrumlabs.com" target="_blank" rel="noopener noreferrer">Meldrum Labs</a> AB · MIT License · <a href="/privacy">Privacy</a>
						<br/>
						<span class="trademark-notice">Apache Arrow and Apache DataFusion are trademarks of the Apache Software Foundation.</span>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>

<style>
	@font-face {
		font-family: 'Geist Mono';
		src: url('/fonts/GeistMono-Regular.otf') format('opentype');
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}

	:root {
		--obsidian-base: #08080A;
		--obsidian-surface: #121215;
		--obsidian-elevated: #1A1A1E;
		--obsidian-hover: #242428;
		--obsidian-active: #2C2C32;
		--obsidian-border-subtle: #26262C;
		--obsidian-border-default: #34343C;
		--obsidian-border-focus: #375048;
		--obsidian-text-primary: #F8F8FC;
		--obsidian-text-secondary: #9E9EA8;
		--obsidian-text-tertiary: #646470;
		--obsidian-accent: #10B981;
		--obsidian-accent-hover: #34D399;
		--obsidian-accent-muted: #142822;
		--obsidian-accent-glow: rgba(16, 185, 129, 0.12);
	}

	/* Theme toggle button */
	.theme-toggle {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.35rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--obsidian-text-secondary);
		transition: color 0.15s ease;
		margin-left: 1rem;
	}

	.theme-toggle:hover {
		color: var(--obsidian-accent);
	}

	.theme-icon-moon { display: none; }
	.theme-icon-sun { display: block; }
	[data-site-theme="light"] .theme-icon-moon { display: block; }
	[data-site-theme="light"] .theme-icon-sun { display: none; }

	/* Light mode overrides */
	.mobile-theme-toggle {
		background: none;
		border: none;
		cursor: pointer;
		text-align: left;
	}

	[data-site-theme="light"] .header {
		background-color: rgba(251, 251, 252, 0.85);
	}

	[data-site-theme="light"] .mobile-menu {
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
	}

	[data-site-theme="light"] .download-card-featured:hover {
		background-color: rgba(16, 185, 129, 0.06);
	}

	html, body {
		font-family: 'Geist Mono', monospace, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		margin: 0;
		padding: 0;
		height: 100%;
		background-color: var(--obsidian-base);
		color: var(--obsidian-text-primary);
	}

	html {
		height: 100%;
	}

	body {
		min-height: 100vh;
	}

	.page {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.header {
		z-index: 100;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		max-width: 100%;
		padding: 1rem 1.5rem;
		background-color: rgba(8, 8, 10, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--obsidian-border-subtle);
		box-sizing: border-box;
		overflow: visible;
	}

	.header-content {
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		align-items: center;
		height: 100%;
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		position: relative;
	}

	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
		flex-shrink: 1;
	}

	.site-title {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}

	.site-title img {
		height: 3rem;
		width: auto;
		max-width: 100%;
	}

	.right-group {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		margin-left: auto;
	}

	.header-links {
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}

	.header-link {
		font-size: 0.875rem;
		font-family: monospace;
		color: var(--obsidian-text-primary);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.header-link:hover {
		color: var(--obsidian-accent-hover);
	}

	.header-link .star-count {
		display: inline-block;
		color: var(--obsidian-text-secondary) !important;
		font-weight: normal;
		margin-left: 0.25rem;
		transition: none !important;
	}

	.mobile-menu-toggle {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		margin: -0.5rem;
		align-items: center;
		justify-content: center;
		position: relative;
		width: 2rem;
		height: 2rem;
		color: var(--obsidian-text-primary);
	}

	.menu-icon {
		position: absolute;
		font-size: 1.2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: opacity 0.2s ease;
	}

	.menu-icon-bars {
		opacity: 1;
	}

	.menu-icon-times {
		opacity: 0;
	}

	.mobile-menu-toggle[aria-expanded="true"] .menu-icon-bars {
		opacity: 0;
	}

	.mobile-menu-toggle[aria-expanded="true"] .menu-icon-times {
		opacity: 1;
	}

	.mobile-menu {
		display: none;
		flex-direction: column;
		gap: 1rem;
		padding: 1rem 0;
		border-top: 1px solid var(--obsidian-border-default);
		background-color: var(--obsidian-base);
		position: absolute;
		top: 100%;
		left: -1.5rem;
		right: -1.5rem;
		z-index: 1000;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}

	.mobile-menu.open {
		display: flex;
	}

	.mobile-menu-link {
		font-size: 0.875rem;
		font-family: monospace;
		color: var(--obsidian-text-primary);
		text-decoration: none;
		transition: color 0.15s ease;
		padding: 0.5rem 0;
	}

	.mobile-menu-link:hover {
		color: var(--obsidian-accent-hover);
	}

	.mobile-menu-link .star-count {
		display: inline-block;
		color: var(--obsidian-text-secondary) !important;
		font-weight: normal;
		margin-left: 0.25rem;
		transition: none !important;
	}

	@media (max-width: 768px) {
		.header-links {
			display: none;
		}

		.mobile-menu-toggle {
			display: flex;
		}
	}

	.main {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding-top: 5rem;
	}

	.downloads-section {
		width: 100%;
		padding: 6rem 1.5rem;
		background-color: var(--obsidian-base);
		flex: 1;
		display: flex;
		align-items: center;
	}

	.downloads-content {
		max-width: 1000px;
		margin: 0 auto;
		text-align: center;
		width: 100%;
	}

	.downloads-title {
		font-family: 'Geist Mono', monospace;
		font-size: 2.5rem;
		font-weight: bold;
		color: var(--obsidian-accent);
		margin: 0 0 1rem 0;
	}

	.downloads-subtitle {
		font-family: 'Geist Mono', monospace;
		font-size: 1.125rem;
		color: var(--obsidian-text-secondary);
		margin: 0 0 3rem 0;
	}

	/* Primary two-card grid */
	.downloads-grid-primary {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		max-width: 560px;
		margin: 0 auto;
	}

	.download-card {
		background-color: var(--obsidian-surface);
		border: 2px solid var(--obsidian-border-default);
		border-radius: 0.5rem;
		padding: 2.5rem 1.5rem;
		transition: all 0.2s ease;
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.download-card:hover {
		border-color: var(--obsidian-accent);
		transform: translateY(-2px);
	}

	.download-card-featured {
		border-color: var(--obsidian-accent);
		background-color: var(--obsidian-accent-muted);
	}

	.download-card-featured:hover {
		background-color: rgba(16, 185, 129, 0.12);
	}

	.download-icon {
		color: var(--obsidian-accent);
		margin-bottom: 0.5rem;
	}

	.download-platform {
		font-family: 'Geist Mono', monospace;
		font-size: 1.25rem;
		font-weight: bold;
		color: var(--obsidian-text-primary);
		margin: 0;
	}

	.download-detail {
		font-family: 'Geist Mono', monospace;
		font-size: 0.875rem;
		color: var(--obsidian-text-tertiary);
		margin: 0;
	}

	.terminal-install {
		margin-top: 2.5rem;
	}

	.terminal-label {
		font-family: 'Geist Mono', monospace;
		font-size: 0.75rem;
		color: var(--obsidian-text-tertiary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin: 0 0 0.625rem 0;
	}

	.terminal-block {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		background-color: var(--obsidian-surface);
		border: 1px solid var(--obsidian-border-default);
		border-radius: 0.375rem;
		padding: 0.5rem 0.875rem;
	}

	.terminal-prompt {
		font-family: 'Geist Mono', monospace;
		font-size: 0.875rem;
		color: var(--obsidian-accent);
		user-select: none;
		flex-shrink: 0;
	}

	.terminal-command {
		font-family: 'Geist Mono', monospace;
		font-size: 0.875rem;
		color: var(--obsidian-text-primary);
		white-space: nowrap;
	}

	.terminal-copy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--obsidian-text-tertiary);
		background: none;
		border: none;
		padding: 0.25rem;
		cursor: pointer;
		transition: color 0.15s ease;
		flex-shrink: 0;
	}

	.terminal-copy:hover {
		color: var(--obsidian-accent);
	}

	@media (max-width: 768px) {
		.downloads-section {
			padding: 4rem 1rem;
		}

		.downloads-title {
			font-size: 2rem;
		}

		.downloads-subtitle {
			font-size: 1rem;
		}

		.downloads-grid-primary {
			grid-template-columns: 1fr;
			max-width: 320px;
			gap: 1rem;
		}

		.download-card {
			padding: 2rem 1.5rem;
		}
	}

	.footer {
		width: 100%;
		max-width: 100%;
		border-top: 1px solid var(--obsidian-border-subtle);
		padding: 1.5rem;
		background-color: var(--obsidian-base);
		margin-top: auto;
		box-sizing: border-box;
		overflow: hidden;
	}

	.footer-bottom {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		align-items: center;
	}

	.copyright-wrapper {
		font-size: 0.875rem;
		font-family: 'Geist Mono', monospace;
		text-align: center;
		color: var(--obsidian-text-secondary);
	}

	.copyright-wrapper a {
		color: var(--obsidian-text-secondary);
		text-decoration: none;
		border-bottom: 1px solid var(--obsidian-text-tertiary);
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.copyright-wrapper a:hover {
		color: var(--obsidian-accent);
		border-bottom-color: var(--obsidian-accent);
	}

	.trademark-notice {
		font-size: 0.7rem;
		color: var(--obsidian-text-tertiary);
		display: inline-block;
		margin-top: 0.5rem;
	}

	@media (max-width: 768px) {
		.footer {
			padding: 2rem 1rem 1rem 1rem;
		}
	}

	@media (min-width: 50rem) {
		.header {
			padding: 1rem 2rem;
		}

		.footer {
			padding: 3rem 2rem 1.5rem 2rem;
		}
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// Mobile menu toggle
		const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
		const mobileMenu = document.getElementById('mobile-menu');

		if (mobileMenuToggle && mobileMenu) {
			mobileMenuToggle.addEventListener('click', () => {
				const isExpanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
				mobileMenuToggle.setAttribute('aria-expanded', (!isExpanded).toString());
				mobileMenu.classList.toggle('open', !isExpanded);
			});

			const mobileMenuLinks = mobileMenu.querySelectorAll('.mobile-menu-link');
			mobileMenuLinks.forEach(link => {
				link.addEventListener('click', () => {
					mobileMenuToggle.setAttribute('aria-expanded', 'false');
					mobileMenu.classList.remove('open');
				});
			});
		}

		// Fetch GitHub star count
		const githubLink = document.getElementById('github-link');
		const mobileGithubLink = document.getElementById('mobile-github-link');

		const updateGithubLinks = (stars: number) => {
			let formattedStars;
			if (stars >= 1000) {
				formattedStars = (stars / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
			} else {
				formattedStars = stars.toString();
			}

			const starHtml = `github <span class="star-count">[${formattedStars}★]</span>`;

			if (githubLink) {
				githubLink.innerHTML = starHtml;
			}
			if (mobileGithubLink) {
				mobileGithubLink.innerHTML = starHtml;
			}
		};

		if (githubLink || mobileGithubLink) {
			fetch('https://api.github.com/repos/meldrumlabs/enya')
				.then(response => response.json())
				.then(data => {
					if (data.stargazers_count) {
						updateGithubLinks(data.stargazers_count);
					}
				})
				.catch(error => {
					console.error('Failed to fetch GitHub stars:', error);
				});
		}
	});
</script>
