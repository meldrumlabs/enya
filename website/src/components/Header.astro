---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import Search from '@astrojs/starlight/components/Search.astro';

---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-hidden md:sl-flex right-group print:hidden">
		<div class="search-wrapper print:hidden">
			<Search />
		</div>
		<div class="sl-flex header-links">
			<a href="https://github.com/meldrumlabs/enya" target="_blank" rel="noopener noreferrer" class="header-link">github</a>
			<button class="theme-toggle" onclick="toggleTheme()" aria-label="Switch to light mode">
				<svg class="theme-icon theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
				<svg class="theme-icon theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
			</button>
			<a href="/download" class="header-download">
				<svg class="header-download-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
					<polyline points="7 10 12 15 17 10"/>
					<line x1="12" y1="15" x2="12" y2="3"/>
				</svg>
				get
			</a>
		</div>
	</div>
</div>

<style>
        .header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
			overflow: clip;
			/* Avoid clipping focus ring around link inside title wrapper. */
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.search-wrapper {
			flex: 1;
			width: 360px;
			justify-content: flex-end;
		}

		.right-group {
			gap: 1rem;
			align-items: center;
		}

		.header-links {
			display: flex;
			gap: 1.5rem;
			align-items: center;
		}

		.header-link {
			font-size: 0.875rem;
			font-family: monospace;
			color: var(--sl-color-text);
			text-decoration: none;
			transition: color 0.2s ease;
		}

		.header-link:hover {
			color: var(--obsidian-accent-hover);
		}

		.theme-toggle {
			background: none;
			border: none;
			cursor: pointer;
			padding: 0.35rem;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			color: var(--obsidian-text-secondary);
			transition: color 0.15s ease;
		}

		.theme-toggle:hover {
			color: var(--obsidian-accent);
		}

		.theme-icon-moon { display: none; }
		.theme-icon-sun { display: block; }

		.header-download {
			font-size: 0.875rem;
			font-family: monospace;
			color: var(--obsidian-base);
			background-color: var(--obsidian-accent);
			text-decoration: none;
			padding: 0.35rem 0.75rem;
			border-radius: 0.25rem;
			transition: all 0.15s ease;
			margin-left: 0.5rem;
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
		}

		.header-download:hover {
			background-color: var(--obsidian-accent-hover);
		}

		.header-download-icon {
			flex-shrink: 0;
		}

        .sl-flex {
            display: flex;
        }
</style>