{
  "title": "Production API Dashboard",
  "description": "Overview of production API health and performance",
  "uid": "prod-api-overview",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{env=\"prod\"}[5m])) by (method)",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_errors_total{env=\"prod\"}[5m])) / sum(rate(http_requests_total{env=\"prod\"}[5m])) * 100"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Connections",
      "type": "gauge",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(db_connections_active{env=\"prod\"})"
        }
      ]
    },
    {
      "id": 4,
      "title": "P99 Latency",
      "type": "stat",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{env=\"prod\"}[5m])) by (le))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Memory Usage",
      "type": "gauge",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{env=\"prod\"} / 1024 / 1024 / 1024"
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU Usage by Service",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "avg(rate(process_cpu_seconds_total{env=\"prod\"}[5m])) by (service) * 100",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Request Latency Distribution",
      "type": "heatmap",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_bucket{env=\"prod\"}[5m])) by (le)"
        }
      ]
    },
    {
      "id": 8,
      "title": "Top Endpoints by Traffic",
      "type": "barchart",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 },
      "targets": [
        {
          "expr": "topk(10, sum(rate(http_requests_total{env=\"prod\"}[5m])) by (endpoint))"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "current": { "value": "prod", "text": "prod" }
      }
    ]
  }
}
